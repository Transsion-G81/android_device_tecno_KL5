From edbf0b87d06577bcfba038acbb11ad1d4983a147 Mon Sep 17 00:00:00 2001
From: nazephyrus <naden.irsyad01@gmail.com>
Date: Sat, 24 Oct 2026 08:44:07 +0700
Subject: [PATCH 2/2] nfc: deactivate before a re-sent RF_DISCOVER in
 phNxpNciHal_write()

libnfc-nci reconfigures a running discovery by re-sending RF_DISCOVER
(the KL5n logs show two identical 21 03 writes ~26 ms apart right before
a tag activates).  The second one is rejected by the PN557 with
CORE_GENERIC_ERROR_NTF (DISCOVERY_ALREADY_STARTED) instead of
RF_DISCOVER_RSP, and the controller then stops servicing the tag session
that was just activated: reSelect timeouts -> nfc_ncif_cmd_timeout ->
NFA_DM_NFCC_TIMEOUT_EVT -> NfcService: restartStack.

When NciDiscoveryCommandBuilderInstance.isRfDiscoveryCommandReceived()
says a discovery command was already forwarded, send RF_DEACTIVATE
(deactivate-to-idle) first so the re-sent RF_DISCOVER is accepted.
phNxpNciHal_send_ext_cmd() consumes the RSP/NTF internally, so the
injected deactivate is not visible to the stack.

Applies to hardware/nxp/nfc @ lineage-23.2 (snxxx, AIDL HAL).
---
 snxxx/halimpl/hal/phNxpNciHal.cc | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/snxxx/halimpl/hal/phNxpNciHal.cc b/snxxx/halimpl/hal/phNxpNciHal.cc
index 8c31d5e..3d6785f 100644
--- a/snxxx/halimpl/hal/phNxpNciHal.cc
+++ b/snxxx/halimpl/hal/phNxpNciHal.cc
@@ -1155,6 +1155,22 @@ int phNxpNciHal_write(uint16_t data_len, const uint8_t* p_data) {
     return phNxpNciHal_handleVendorSpecificCommand(data_len, p_data);
   } else if (p_data[NCI_GID_INDEX] == NCI_RF_DISC_COMMD_GID &&
              p_data[NCI_OID_INDEX] == NCI_RF_DISC_COMMAND_OID) {
+    /* libnfc-nci re-sends RF_DISCOVER to reconfigure an already running
+     * discovery (two identical 21 03 writes 26 ms apart appear in the KL5n
+     * logs right before the tag activates).  The NFCC answers the second one
+     * with CORE_GENERIC_ERROR_NTF (DISCOVERY_ALREADY_STARTED) instead of
+     * RF_DISCOVER_RSP and then stops servicing the ongoing tag session
+     * (reSelect timeouts -> nfc_ncif_cmd_timeout).  Stop the running discovery
+     * first so the re-send is accepted - this is the same command libnfc-nci
+     * itself uses when it restarts discovery. */
+    if (NciDiscoveryCommandBuilderInstance.isRfDiscoveryCommandReceived()) {
+      uint8_t cmd_disable_disc[] = {0x21, 0x06, 0x01, 0x00};
+      NFCSTATUS status = phNxpNciHal_send_ext_cmd(sizeof(cmd_disable_disc),
+                                                  cmd_disable_disc);
+      if (status != NFCSTATUS_SUCCESS) {
+        NXPLOG_NCIHAL_E("CMD_DISABLE_DISCOVERY before RF_DISCOVER: Failed");
+      }
+    }
     NciDiscoveryCommandBuilderInstance.setDiscoveryCommand(data_len, p_data);
     if (isObserveModeEnabled()) {
       vector<uint8_t> v_data =
