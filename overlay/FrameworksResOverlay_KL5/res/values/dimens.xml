<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds.  Do not translate.

     NOTE: The naming convention is "config_camelCaseValue". Some legacy
     entries do not follow the convention, but all new entries should. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Status bar heights: stock is 40dip portrait / 28dip landscape, +4dip so
         the bar content sits lower under the punch-hole (see config.xml). -->
    <dimen name="status_bar_height_default">44.0dip</dimen>
    <dimen name="status_bar_height_portrait">44.0dip</dimen>
    <dimen name="status_bar_height_landscape">28.0dip</dimen>
    <!-- Navigation bar and display corners: stock KL5n values. -->
    <dimen name="navigation_bar_height">40.0dip</dimen>
    <dimen name="navigation_bar_height_landscape">40.0dip</dimen>
    <dimen name="rounded_corner_radius">12.0dip</dimen>
    <dimen name="rounded_corner_radius_top">12.0dip</dimen>
    <dimen name="rounded_corner_radius_bottom">12.0dip</dimen>
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
</resources>
