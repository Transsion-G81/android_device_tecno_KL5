diff --git a/packages/modules/Nfc/libnfc-nci/src/nfa/dm/nfa_dm_discover.cc b/packages/modules/Nfc/libnfc-nci/src/nfa/dm/nfa_dm_discover.cc
--- a/packages/modules/Nfc/libnfc-nci/src/nfa/dm/nfa_dm_discover.cc
+++ b/packages/modules/Nfc/libnfc-nci/src/nfa/dm/nfa_dm_discover.cc
@@ -2559,6 +2559,16 @@ static void nfa_dm_disc_sm_poll_active(tNFA_DM_RF_DISC_SM_EVENT event,
                                           tNFA_DM_RF_DISC_DATA* p_data) {
   switch (event) {
     case NFA_DM_CORE_INTF_ERROR_NTF:
+    case NFA_DM_RF_INTF_ACTIVATED_NTF:
+      /* Card re-activated while still in POLL_ACTIVE (deactivation NTF was
+       * lost, e.g. NXP PN557 firmware with card still in field). Stop the
+       * deact-NTF timeout, clear pending flags, and treat as fresh activation.
+       */
+      nfa_sys_stop_timer(&nfa_dm_cb.disc_cb.tle);
+      nfa_dm_cb.disc_cb.disc_flags &= ~(NFA_DM_DISC_FLAGS_W4_RSP | NFA_DM_DISC_FLAGS_W4_NTF);
+      if (nfa_dm_disc_notify_activation(&(p_data->nfc_discover)) == NFA_STATUS_FAILED) {
+        LOG(VERBOSE) << StringPrintf(
+            "%s: Not matched, restart discovery after receiving deactivate ntf", __func__);
+        nfa_dm_cb.disc_cb.disc_flags |= (NFA_DM_DISC_FLAGS_W4_RSP | NFA_DM_DISC_FLAGS_W4_NTF);
+        NFC_Deactivate(NFA_DEACTIVATE_TYPE_IDLE);
+      }
+      break;
     default:
       LOG(ERROR) << StringPrintf("%s: Unexpected discovery event", __func__);
       break;
