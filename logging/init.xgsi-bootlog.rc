# XGSI da1adf94cf77
service xgsi_dmesg /system/bin/sh /system/etc/xgsi/xgsi-dmesg.sh
    class core
    user root
    group root log readproc
    seclabel u:r:xgsi_log:s0
    oneshot
    disabled

service xgsi_bootlog /system/bin/sh /system/etc/xgsi/xgsi-bootlog.sh
    class core
    user root
    group root log readproc
    seclabel u:r:xgsi_log:s0
    oneshot
    disabled

on post-fs
    start xgsi_dmesg

on late-fs
    start xgsi_dmesg
    start xgsi_bootlog

on post-fs-data
    mkdir /data/xgsi 0770 root root
    restorecon_recursive /data/xgsi
    start xgsi_dmesg
    start xgsi_bootlog
