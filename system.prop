# Blur
ro.surface_flinger.supports_background_blur=0

# Charger
ro.charger.enable_suspend=true

# Dalvik
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.heapstartsize=8m
dalvik.vm.heapmaxfree=8m
dalvik.vm.heapminfree=512k
dalvik.vm.heaptargetutilization=0.6
ro.limit_cache.support=1
ro.cur_max_process.val=72

# Kernel
ro.kernel.zio=38,108,105,16

# Identity
Build.BRAND=MTK

# IPO
sys.ipo.disable=1
sys.ipo.pwrdncap=2

# Memory Optimization
ro.config.dha_cached_max=32
ro.config.dha_cached_min=16
ro.config.per_app_memcg=false

# MTK vendor
ro.vendor.mtk_omacp_support=1
ro.vendor.mtk_telephony_add_on_policy=0

# Performance
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1
ro.mtk_perf_simple_start_win=1
security.perf_harden=1
qs.limited=1
qs.fps.limited=2
qs.blur.fps.limited=2

# Power off opt in IPO
sys.ipo.pwrdncap=2

# Radio
persist.sys.radio.force_lte_ca=true
vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0

# RIL Powersaving
persist.radio.add_power_save=1
pm.sleep_mode=1
power.saving.mode=1
ro.mot.eri.losalert.delay=100
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3
ro.vendor.use_data_netmgrd=true
ro.vold.umsdirtyratio=20

# SLA
ro.vendor.net.enable_sla=1

# Thermal Management
persist.thermal_config.mitigation=1
ro.mtk_thermal_monitor.enabled=true

# Thermal Configuration
ro.config.thermal_dcs=40
ro.config.thermal_limit=75

# USB MTP WHQL
ro.sys.usb.mtp.whql.enable=0

# USB BICR function
ro.sys.usb.bicr=no

# USB 
ro.sys.usb.charging.only=yes
ro.sys.usb.storage.type=mtp

# Wlan
wifi.interface=wlan0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# ZRAM
ro.zram.first_wb_delay_mins=1440
ro.zram.mark_idle_delay_mins=60
ro.zram.periodic_wb_delay_hours=24

# Zygote
zygote.critical_window.minute=10
